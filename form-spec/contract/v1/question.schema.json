{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpler.grants.gov/form-spec/contract/v1/question.schema.json",
  "title": "Question schema artifact",
  "description": "A portable JSON Schema build target for one semantic question block.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    }
  ],
  "required": [
    "$schema",
    "$id",
    "type"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "$id": {
      "type": "string",
      "minLength": 1,
      "pattern": "(^|/)schema\\.json$"
    },
    "type": {
      "enum": [
        "array",
        "boolean",
        "integer",
        "number",
        "object",
        "string"
      ]
    }
  }
}
