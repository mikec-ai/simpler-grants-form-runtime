{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grants:portable-form-contract:v2",
  "title": "Portable grants form contract v2",
  "description": "Producer-neutral contract for authoring catalogs, form declarations, and compiled portable form bundles.",
  "oneOf": [
    {"$ref": "#/$defs/catalog"},
    {"$ref": "#/$defs/formDeclaration"},
    {"$ref": "#/$defs/runtimeBundle"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "mappingState": {
      "enum": [
        "agent_proposed",
        "agent_reviewed",
        "human_reviewed",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "reviewer": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["agent", "human", "system"]},
        "id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "semanticReviewEvent": {
      "type": "object",
      "required": ["event_id", "state"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "state": {"$ref": "#/$defs/mappingState"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "reviewer": {"$ref": "#/$defs/reviewer"},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "semanticReview": {
      "type": "object",
      "required": ["status", "events"],
      "properties": {
        "status": {"$ref": "#/$defs/mappingState"},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/semanticReviewEvent"}
        }
      },
      "additionalProperties": false
    },
    "occurrenceEvidence": {
      "type": "object",
      "required": ["source_ref", "locator"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "locator": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {
              "enum": ["xsd_path", "xml_path", "dat_path", "pdf_page", "source_record"]
            },
            "value": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "kind",
        "repository",
        "revision",
        "path",
        "sha256",
        "source_version"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authoritative_source",
            "implementation_oracle",
            "agent_derivation"
          ]
        },
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "schemaDescriptor": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "validation_fragment_id",
        "question_id",
        "artifact",
        "source_evidence"
      ],
      "properties": {
        "kind": {"enum": ["question", "form"]},
        "id": {"type": "string", "minLength": 1},
        "validation_fragment_id": {"type": ["string", "null"]},
        "question_id": {"type": ["string", "null"]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "source_evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "question"}}},
          "then": {
            "properties": {
              "question_id": {"type": "string", "minLength": 1},
              "validation_fragment_id": {"type": "string", "minLength": 1},
              "source_evidence": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "question_id": {"const": null},
              "validation_fragment_id": {"const": null},
              "source_evidence": {"maxItems": 0}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "formMetadata": {
      "type": "object",
      "required": [
        "legacy_form_id",
        "form_name",
        "short_form_name",
        "form_version",
        "agency_code",
        "omb_number",
        "is_deprecated"
      ],
      "properties": {
        "legacy_form_id": {"type": ["integer", "null"]},
        "form_name": {"type": "string", "minLength": 1},
        "short_form_name": {"type": "string", "minLength": 1},
        "form_version": {"type": "string", "minLength": 1},
        "agency_code": {"type": "string", "minLength": 1},
        "omb_number": {"type": "string"},
        "is_deprecated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "cardinality": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 0},
        "max": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "occurrenceContext": {
      "type": "object",
      "required": ["scope"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "repetition": {"type": "string", "minLength": 1},
        "repeat_pointer": {"type": ["string", "null"]},
        "repeat_ancestors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ordinal": {"type": "integer", "minimum": 0},
        "outer_repeat_pointer": {"type": "string", "minLength": 1},
        "outer_repeat_max": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "questionBinding": {
      "type": "object",
      "required": [
        "binding_id",
        "question_id",
        "schema_id",
        "validation_fragment_id",
        "form_pointer",
        "role",
        "cardinality",
        "context",
        "occurrence_evidence",
        "mapping_refs",
        "semantic_review"
      ],
      "properties": {
        "binding_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "minLength": 1},
        "schema_id": {"type": "string", "minLength": 1},
        "validation_fragment_id": {"type": "string", "minLength": 1},
        "form_pointer": {"type": "string", "pattern": "^/"},
        "role": {"type": "string", "minLength": 1},
        "cardinality": {"$ref": "#/$defs/cardinality"},
        "context": {"$ref": "#/$defs/occurrenceContext"},
        "occurrence_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/occurrenceEvidence"}
        },
        "mapping_refs": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "semantic_review": {"$ref": "#/$defs/semanticReview"},
        "analysis_classification": {
          "enum": ["semantic_question", "content_capture_mechanism"]
        }
      },
      "additionalProperties": false
    },
    "reviewBoundary": {
      "type": "object",
      "required": [
        "semantic_mappings",
        "published_coverage_eligible",
        "production_ready"
      ],
      "properties": {
        "semantic_mappings": {"$ref": "#/$defs/semanticReview"},
        "published_coverage_eligible": {"type": "boolean"},
        "production_ready": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "adapterDescriptor": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifact"}
        },
        "configuration": {"type": "object"}
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "formCommon": {
      "type": "object",
      "required": [
        "form_key",
        "schema_id",
        "metadata",
        "ui",
        "mappings",
        "question_bindings",
        "supplemental_evidence",
        "review_boundary"
      ],
      "properties": {
        "form_key": {"type": "string", "minLength": 1},
        "schema_id": {"type": "string", "minLength": 1},
        "metadata": {"$ref": "#/$defs/formMetadata"},
        "ui": {"$ref": "#/$defs/artifact"},
        "mappings": {"$ref": "#/$defs/artifact"},
        "adapters": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/adapterDescriptor"}
        },
        "question_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/questionBinding"}
        },
        "supplemental_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        },
        "review_boundary": {"$ref": "#/$defs/reviewBoundary"}
      }
    },
    "formDeclaration": {
      "allOf": [
        {"$ref": "#/$defs/formCommon"},
        {
          "type": "object",
          "required": ["contract", "source_refs"],
          "properties": {
            "contract": {"const": "portable-grants-form-declaration/v2"},
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "runtimeForm": {
      "allOf": [
        {"$ref": "#/$defs/formCommon"},
        {
          "type": "object",
          "required": ["source_evidence"],
          "properties": {
            "source_evidence": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/sourceEvidence"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "catalog": {
      "type": "object",
      "required": [
        "contract",
        "runtime_contract",
        "contract_schema",
        "bundle",
        "sources",
        "schemas",
        "validation_fragments",
        "compatibility",
        "form_declarations"
      ],
      "properties": {
        "contract": {"const": "portable-grants-form-catalog/v2"},
        "runtime_contract": {"const": "portable-grants-form-bundle/v2"},
        "contract_schema": {"$ref": "#/$defs/artifact"},
        "bundle": {"$ref": "#/$defs/bundleMetadata"},
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sourceEvidence"}
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/schemaDescriptor"}
        },
        "validation_fragments": {"$ref": "#/$defs/artifact"},
        "compatibility": {"$ref": "#/$defs/artifact"},
        "form_declarations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      },
      "additionalProperties": false
    },
    "bundleMetadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "runtimeBundle": {
      "type": "object",
      "required": [
        "contract",
        "contract_schema",
        "bundle",
        "sources",
        "schemas",
        "validation_fragments",
        "compatibility",
        "forms"
      ],
      "properties": {
        "contract": {"const": "portable-grants-form-bundle/v2"},
        "contract_schema": {"$ref": "#/$defs/artifact"},
        "bundle": {"$ref": "#/$defs/bundleMetadata"},
        "sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sourceEvidence"}
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/schemaDescriptor"}
        },
        "validation_fragments": {"$ref": "#/$defs/artifact"},
        "compatibility": {"$ref": "#/$defs/artifact"},
        "forms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/runtimeForm"}
        }
      },
      "additionalProperties": false
    }
  }
}
