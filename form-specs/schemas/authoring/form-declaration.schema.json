{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grants:portable-form-authoring:form-declaration:v1",
  "type": "object",
  "required": [
    "contract",
    "form_key",
    "schema_id",
    "metadata",
    "ui",
    "mappings",
    "question_bindings",
    "source_refs",
    "supplemental_evidence",
    "review_boundary"
  ],
  "properties": {
    "contract": {"const": "portable-grants-form-declaration/v1"},
    "form_key": {"type": "string", "minLength": 1},
    "schema_id": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "ui": {"$ref": "#/$defs/artifact"},
    "mappings": {"$ref": "#/$defs/artifact"},
    "adapters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["artifacts"],
        "properties": {
          "artifacts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"$ref": "#/$defs/artifact"}
          }
        },
        "additionalProperties": false
      }
    },
    "question_bindings": {"type": "array"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "supplemental_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "review_boundary": {"type": "object"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
