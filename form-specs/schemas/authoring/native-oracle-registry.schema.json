{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grants:portable-form-build:native-oracle-registry:v1",
  "type": "object",
  "required": ["contract", "oracles"],
  "properties": {
    "contract": {"const": "portable-native-oracle-registry/v1"},
    "oracles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["form_key", "module", "implementation_source", "artifacts"],
        "properties": {
          "form_key": {"type": "string", "minLength": 1},
          "module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
          "implementation_source": {"$ref": "#/$defs/artifact"},
          "artifacts": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "anyOf": [
                {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
                {"type": "null"}
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
